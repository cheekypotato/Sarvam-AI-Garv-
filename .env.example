# Copy to .env and fill in. Safe to commit (contains no secrets).
SARVAM_API_KEY=

LEDGER_LANGUAGE=hi-IN
DOC_POLL_INTERVAL_SECONDS=3
DOC_TIMEOUT_SECONDS=180

STT_MODEL=saaras:v3
STT_MODE=transcribe
STT_LANGUAGE=unknown
MAX_AUDIO_SECONDS=30

CHAT_MODEL=sarvam-105b
CHAT_REASONING_EFFORT=

TTS_MODEL=bulbul:v3
TTS_SPEAKER=shubh
TTS_FALLBACK_LANGUAGE=hi-IN
TTS_MAX_CHARS=2500

DB_PATH=./data/ledger.db
DEMO_MODE=false
FIXTURES_DIR=./fixtures
LOG_LEVEL=INFO
